# ---------- Site ----------
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=TopSpot
# optional: your X/Twitter handle without @ (used in metadata)
NEXT_PUBLIC_TWITTER=
CONTACT_EMAIL=hello@yourdomain.com

# ---------- Search engine verification (paste only the token) ----------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key: any 16-64 chars [a-zA-Z0-9]. Served at /<key>.txt automatically.
INDEXNOW_KEY=

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only - never expose, never commit
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe (cards, USD) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Razorpay (UPI / INR) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# INR per 1 USD used to price UPI orders (update when the rate moves)
USD_INR_RATE=88
